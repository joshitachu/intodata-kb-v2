          "type": "array"
        },
        "boundary_decisions": {
          "items": {
            "type": "string"
          },
          "title": "Boundary Decisions",
          "type": "array"
        },
        "budget_class": {
          "title": "Budget Class",
          "type": "string"
        },
        "forbidden_effects": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Effects",
          "type": "array"
        },
        "grounding": {
          "$ref": "#/$defs/GroundingExpectation"
        },
        "mechanics": {
