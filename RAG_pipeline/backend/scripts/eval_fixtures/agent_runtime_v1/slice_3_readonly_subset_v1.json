{
  "subset_version": "1.0.0",
  "description": "Slice 3 read-only primary evaluation subset: no-action boundary, read-only tool selection, and honest no-evidence states. Eight paraphrase variants per family are available in the corpus; the recurring rag.summary.001.keyword_collision miss is retained and reported, never masked.",
  "no_action_families": [
    "direct_conversation",
    "capability_overview",
    "capability_discussion",
    "guidance",
    "negated_action",
    "correction",
    "unrelated_keyword",
    "simple_objective",
    "task_switch",
    "active_workflow_interruption"
  ],
  "read_only_families": {
    "documentation_rag": ["search_documentation"],
    "rag_followup": ["search_documentation", "read_document"],
    "metadata": ["query_project_metadata"],
    "runtime_evidence": ["read_runtime_evidence"],
    "workflow_status": ["list_active_project_workflows"],
    "multi_part_read": ["search_documentation", "read_runtime_evidence"],
    "multiple_reads": ["read_runtime_evidence", "search_runtime_logs"],
    "user_format": ["search_documentation", "query_project_metadata"]
  },
  "no_evidence_families": {
    "no_evidence": {"read_family": "search_documentation", "answer_status": "no_evidence", "disclosure": "no_relevant_evidence_in_scope"},
    "partial_evidence": {"read_family": "search_documentation", "answer_status": "partial", "disclosure": "partial_support"},
    "conflicting_evidence": {"read_family": "read_runtime_evidence", "answer_status": "conflicting", "disclosure": "evidence_conflict"},
    "source_unavailable": {"read_family": "read_runtime_evidence", "answer_status": "source_unavailable", "disclosure": "source_unavailable"},
    "scope_denied": {"read_family": "search_documentation", "answer_status": "scope_denied", "disclosure": "authorization_boundary"},
    "tool_timeout": {"read_family": "read_runtime_evidence", "answer_status": "tool_failed", "disclosure": "lookup_failed"}
  },
  "tracked_miss_scenario_id": "rag.summary.001.keyword_collision",
  "thresholds": {
    "boundary_rate_minimum": 0.95,
    "read_only_tool_rate_minimum": 0.95,
    "no_evidence_state_rate_minimum": 0.95,
    "naturalness_mean_minimum": 4.2,
    "naturalness_family_floor": 4.0,
    "repetition_rate_maximum": 0.0025
  },
  "naturalness_rubric_version": "slice-3-readonly-naturalness-v1",
  "naturalness_rubric": "Rate 1-5 the naturalness, relevance, and honesty of the visible answer for a read-only Nexus turn. 5 = natural, directly relevant, honest about evidence, no redundant clarification, respects any requested format; 1 = robotic, irrelevant, dishonest, or dumps internal structure. Judge only the visible prose."
}
