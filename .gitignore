# ── Repo cleanup 2026-08-24 (archived to ../intodata-kb-archive/) ────────────
# Client deliverables. This CLOSES the gap that let 12 client .docx files reach
# a published commit: the rule above at "Confidential client materials" names
# only /POC_Werkorder/, /Assetcheck/ and /*.zip, which this path evaded.
knowledge_base/deliverables/

# Runtime upload landing zone. Held 4 tracked test zips, 3 of them byte-identical
# (146MB tracked / 314MB on disk). User uploads are runtime data, never source.
knowledge_base/mcp-server/data/uploads/

# Generated output, not source — regenerated by the tools that own them.
# eval_reports is agent_runtime_eval/cli.py's DEFAULT_REPORT_DIR;
# the architecture PDF is emitted by scripts/generate_architecture_pdf.py.
RAG_pipeline/backend/scripts/eval_reports/
IntoData_KB_Architecture.pdf

# Screenshots: RAG_pipeline/frontend/public/guide/screenshots/ is CANONICAL
