# intodata-kb production environment variables
# Copy to .env and update values as needed
# Generate secrets with: openssl rand -hex 32

# ── Mission Control / Fleet (nexus operator server ONLY) ─────────────────────
# Set to true ONLY on the nexus.intodata.nl operator server.
# Customer VPS instances must leave this unset or false — Fleet must never
# be visible to customers.
FLEET_ENABLED=false

# ── Tenant identity (per deployment) ─────────────────────────────────────────
# One VPS per client — these env vars drive the branding shown in the sidebar,
# browser title, login page, and onboarding wizard chrome.
# TENANT_SLUG is the short identifier (usually matches the subdomain, e.g. "acme"
# for acme.intodata.nl). TENANT_ENVIRONMENT controls the small status pill —
# only "production" hides it; anything else (staging / development / preview) renders.
TENANT_NAME=IntoData
TENANT_SLUG=intodata
TENANT_ENVIRONMENT=production

# ── Live runtime (EP-004) ─────────────────────────────────────────────────────
# Provider-agnostic contract surfaced by GET /api/v1/runtime/status and used by
# the backend tool-use loop. Leave RUNTIME_PROVIDER_KEY empty to keep runtime
# disabled (chat indicator shows "disabled"). Provider keys:
#   mock       - credential-free in-memory fixtures (direct), for a quick check
#   stored     - DB-backed held runtime data read from Postgres (Model 2). Seed
#                local demo data with:
#                  cd RAG_pipeline/backend && python -m src.runtime.store.seed --project-id demo-runtime
#   talend_tmc - real Talend adapter (requires the Talend section below)
# RUNTIME_PROVIDER_HEALTH_URL is optional; without it status is "unavailable"
# even when a provider key is set.
# RUNTIME_PROVIDER_KEY=talend_tmc
# RUNTIME_PROVIDER_LABEL=Talend TMC
# RUNTIME_PROVIDER_HEALTH_URL=http://talend-tmc-runtime:9000/health
# RUNTIME_STATUS_TIMEOUT=5.0
# RUNTIME_TOOL_TIMEOUT=10.0
# RUNTIME_TOOL_RESULT_MAX_CHARS=12000
# Optional semantic recall over curated runtime summaries and incidents. Raw
# log lines are never embedded; Postgres full-text search remains primary.
# RUNTIME_SEMANTIC_ENABLED=false

# ── Talend TMC runtime provider (EP-004 slice 5) ──────────────────────────────
# Only needed when RUNTIME_PROVIDER_KEY=talend_tmc. The API token is read from a
# mounted secret FILE, never an env var — do not put the token value in this
# file. See deploy/RUNBOOK.md ("Talend TMC runtime") for creating the secret
# file and bind-mounting it into the backend container.
# TALEND_TMC_BASE_URL=http://talend-tmc-runtime:9000
# TALEND_TMC_API_TOKEN_FILE=/run/secrets/talend_tmc_api_token

# ── Runtime source credential encryption ─────────────────────────────────────
# REQUIRED whenever runtime sources store credentials (e.g. Talend TMC API keys
# imported via POST /api/v1/runtime/sources). The backend encrypts credentials
# at rest with Fernet; without a key the create endpoint fails closed.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable. To rotate: set the new key here, move the OLD key into
# SOURCE_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS, and restart — old rows are
# re-encrypted lazily on next read. Losing both keys loses all stored credentials.
SOURCE_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY
# SOURCE_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# SOURCE_CREDENTIALS_ENCRYPTION_KEY_ID=primary
# SOURCE_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS_ID=previous

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret: openssl rand -hex 32
# IMPORTANT: JWT_SECRET_KEY and MCP_JWT_SECRET_KEY must be the SAME value
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
ADMIN_DEFAULT_PASSWORD=admin
# Set COOKIE_SECURE=true when using HTTPS (nginx/certbot reverse proxy)
COOKIE_SECURE=true
# Set to your DuckDNS or custom domain (e.g. myapp.duckdns.org)
COOKIE_DOMAIN=
# Single origin when behind nginx/certbot reverse proxy
ALLOWED_ORIGINS=https://YOUR_DOMAIN.duckdns.org
# Optional: keep enabled in production unless a trusted upstream handles CSRF.
CSRF_ENABLED=true

# ── Email invites (per deployment) ───────────────────────────────────────────
PUBLIC_APP_URL=https://YOUR_DOMAIN.duckdns.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Legacy alias accepted by docker-compose for older Ansible templates.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=YOUR_COMPANY_NAME
SMTP_USE_TLS=true

# ── Optional SSO / OIDC ──────────────────────────────────────────────────────
SSO_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ── MCP Server (runs in Docker Compose, host port 8002 by default) ───────────
# Password must match POSTGRES_PASSWORD below
MCP_DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@postgres:5432/intodata_kb
MCP_RAG_BASE_URL=http://backend:8000
MCP_INTODOC_COMMAND=intodoc
MCP_CLAUDE_COMMAND=claude
MCP_CLAUDE_MODEL=sonnet

# One Pack activation (docs/one-pack-program.md section 5). Leave EMPTY for the
# legacy behaviour: a run with no pack derives its Phase 2 section contract from
# the built-in constants + data/doc_catalog.yaml. Set to
# "intodata.engineering-handover" to make that pack the source of the contract
# for every no-pack run, so the legacy 10-document output becomes a swappable
# pack rather than the platform itself.
#
# Safe to flip and safe to revert: the contract shape is identical on Talend,
# Workato, Lobster and generic. The one behavioural difference is that a missing
# required section is now published with a named warning instead of silently
# becoming a PARTIAL stub. Clearing this reverts every run -- no migration.

# OpenCode documentation provider. Supply a model route and provider credentials
# through OpenCode/environment configuration; see mcp-server/OPENCODE_OPERATOR.md.
MCP_OPENCODE_COMMAND=opencode
MCP_OPENCODE_CONFIG_PATH=
MCP_OPENCODE_MODEL=
MCP_OPENCODE_PRIMARY_AGENT=build
MCP_OPENCODE_VERSION=1.18.7
MCP_OPENCODE_AUTO_APPROVE=true
MCP_OPENCODE_TIMEOUT_SECONDS=1800
MCP_OPENCODE_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OpenCode Go subscription API key from https://opencode.ai/zen.
MCP_OPENCODE_GO_API_KEY=
MCP_OPENCODE_MCP_READ_ALLOWLIST_JSON={}
MCP_DATA_DIR=/app/data
MCP_INTODOC_OUTPUT_DIR=/app/intodoc-output
MCP_PROJECT_ROOT=/app/workspace
MCP_HINDSIGHT_ENABLED=true
MCP_HINDSIGHT_URL=http://hindsight:8888
MCP_LIVING_DOC_PATCHING_ENABLED=true
MCP_LIVING_DOC_ROLLOUT_STAGE=approval_only
MCP_LOG_LEVEL=INFO
# Must match JWT_SECRET_KEY above
MCP_JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
MCP_ALLOWED_ORIGINS=https://YOUR_DOMAIN.duckdns.org
# API key for MCP->RAG doc ingestion (generate with: openssl rand -hex 32)
MCP_INGEST_API_KEY=CHANGE_ME_TO_A_RANDOM_KEY
# Optional least-privilege MCP service JWT used only for background documentation
# status reconciliation. Leave empty to disable autonomous polling.
MCP_DOCS_RECONCILIATION_SERVICE_TOKEN=
MCP_DOCS_RECONCILIATION_INTERVAL_SECONDS=60
MCP_DOCS_RECONCILIATION_BATCH_SIZE=50
# MCP network hardening — see ALLOWED_IPS / TRUSTED_PROXIES above for meaning
MCP_ALLOWED_IPS=
MCP_TRUSTED_PROXIES=127.0.0.1
MCP_APP_ENV=production
# Public app base URL used for generated GitHub webhook callback URLs.
MCP_PUBLIC_URL=https://YOUR_DOMAIN.duckdns.org
# GitHub webhook secret — generate with: openssl rand -hex 32
# Add the same value in GitHub repo Settings → Webhooks → Secret
MCP_GITHUB_WEBHOOK_SECRET=
# Must be false in production; true skips webhook signature checks.
MCP_DEV_WEBHOOK_SKIP_SIGNATURE=false
# Fernet key for encrypted GitHub PAT storage.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_TOKEN_ENCRYPTION_KEY=
# Host port published by the MCP REST API compose service
MCP_PORT=8002
# Required for governed documentation generation. Only configured Git refs or
# bundled manifests can become generation-authoritative. Git Packs must declare
# the matching certification.provenance in plugin.yaml. Existing reviewed Packs
# may use allow_legacy_migration once to establish their initial content digest.
# Example:
# MCP_PACK_GOVERNANCE_TRUSTED_SOURCES_JSON=[{"kind":"git","repo_url":"https://github.com/YOUR_ORG/documentation-packs","refs":["main","release/*"],"provenance":"org-reviewed","allow_legacy_migration":true}]
MCP_PACK_GOVERNANCE_TRUSTED_SOURCES_JSON=[]

# IntoData Ops telemetry. Disabled unless URL, API key, and client slug are set.
# Payloads contain operational metadata only: health, project status, run
# status, document counts, quality scores, token/cost totals, and redacted
# error summaries. Do not send uploaded docs, source code, generated doc bodies,
# chat history, raw logs, or secrets.
MCP_OPS_CLIENT_SLUG=
MCP_OPS_ENVIRONMENT=production
MCP_OPS_RELEASE_VERSION=
MCP_OPS_TELEMETRY_URL=
MCP_OPS_TELEMETRY_API_KEY=
MCP_OPS_TELEMETRY_INTERVAL_SECONDS=300

# Unified bounded agent-loop limits. Chat has one production route.
AGENT_CHAT_MAX_ITERATIONS=6
AGENT_CHAT_MAX_TOOL_CALLS=4
AGENT_CHAT_DEADLINE_SECONDS=30
AGENT_CHAT_MAX_COST_USD=0.25

# Slice 6 live Agent Run/event projection. Keep disabled until the human gate.
AGENT_RUNTIME_V2_CANARY_STAGE=off
AGENT_RUNTIME_V2_ENABLED=false
AGENT_RUNTIME_V2_READONLY_USERS=[]
AGENT_RUNTIME_V2_READONLY_PERCENT=0
AGENT_RUNTIME_V2_TRANSPORTS=["nonstream","stream"]
AGENT_RUNTIME_V2_PLANNING_ENABLED=false
AGENT_RUNTIME_V2_PLANNING_USERS=[]
AGENT_RUNTIME_V2_PLANNING_PERCENT=0
AGENT_RUNTIME_V2_EFFECTS_ENABLED=false
AGENT_RUNTIME_V2_EFFECT_USERS=[]
AGENT_RUNTIME_V2_EFFECT_PERCENT=0
AGENT_RUNTIME_V2_LIVE_STREAMING_ENABLED=false
AGENT_RUNTIME_V2_LIVE_STREAMING_USERS=[]
AGENT_RUNTIME_V2_LIVE_STREAMING_PERCENT=0
AGENT_RUNTIME_V2_MODEL_TIMEOUT_SECONDS=60
AGENT_RUNTIME_V2_READ_TOOL_TIMEOUT_SECONDS=90
AGENT_RUNTIME_V2_WRITE_TOOL_TIMEOUT_SECONDS=30
AGENT_RUNTIME_V2_WORKFLOW_HANDOFF_TIMEOUT_SECONDS=15
AGENT_RUNTIME_V2_SOFT_DEADLINE_SECONDS=45
AGENT_RUNTIME_V2_HARD_DEADLINE_SECONDS=120
AGENT_RUNTIME_V2_MAX_MODEL_CALLS=8
AGENT_RUNTIME_V2_SYNTHESIS_RESERVE_CALLS=2
AGENT_RUNTIME_V2_PROVIDER_MAX_RETRIES=1

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=intodata_kb
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Email address seeded for the initial admin account on first boot.
# Set this per VPS/customer deployment from Ansible or the deploy UI. This is
# what the customer logs in with.
ADMIN_INITIAL_EMAIL=admin@YOUR_DOMAIN

# ── External APIs ────────────────────────────────────────────────────────────
# QDRANT_URL is intentionally omitted here. docker-compose defaults to
# http://qdrant:6333 (the internal service name), which is correct for all
# docker-compose deployments. Only set this if you are running the backend
# outside of docker-compose and need to point at a remote Qdrant instance.
# QDRANT_URL=http://qdrant:6333
# When set, docker-compose configures both the Qdrant service and clients with
# this API key. Leave blank only for isolated local/dev deployments.
QDRANT_API_KEY=
# Qdrant collection name. One VPS per client means each stack has its own Qdrant,
# so "documents" is fine as a default. Override only when running multiple stacks
# against a shared Qdrant instance (dev / staging on one host).
QDRANT_COLLECTION=documents
VOYAGE_API_KEY=
KIMI_API_KEY=
# Ordered JSON list of explicitly approved fallbacks for documentation answers.
# Leave empty to fail loudly when Kimi is unavailable. Example:
# RAG_APPROVED_FALLBACK_MODELS=["openai/gpt-5.4"]
RAG_APPROVED_FALLBACK_MODELS=[]
RAG_DOCUMENTATION_PROVIDER_MAX_RETRIES=1
# Legacy generic fallback consumed by MCP_DOC_GENERATION_API_KEY when that
# variable is unset. Prefer provider-specific keys below.
LLM_API_KEY=

# ── LLM provider API keys ─────────────────────────────────────────────────────
# Set the key(s) for the providers you use. Unused keys can be left blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OpenRouter — used by openrouter/<vendor>/<model> doc-generation ids and by
# OpenCode openrouter/... session routes (e.g. openrouter/stealth/ox-alpha).
OPENROUTER_API_KEY=

# ── Doc generation (MCP server) ───────────────────────────────────────────────
# PROVIDER selects the generation MECHANISM, not the vendor. Valid values are
# "custom" (the default in-process harness — this is what you want), a full
# "vendor/model" id, "claude-cli", or "opencode-cli". A bare vendor name such as
# "anthropic" is NOT valid and makes every generate run fail with
# "Unsupported model/provider". The vendor comes from the *_MODEL values below.
# Models: phase 1-2 analysis, phase 3 writing, investigation sub-tasks, fallback.
MCP_DOC_GENERATION_PROVIDER=custom
MCP_DOC_GENERATION_MODEL=anthropic/claude-sonnet-4-6
MCP_PACK_AUTHOR_MODEL=kimi/kimi-k2.5
MCP_PACK_AUTHOR_TIMEOUT_SECONDS=120
MCP_PACK_AUTHOR_MAX_OUTPUT_TOKENS=32768
MCP_DOC_GENERATION_WRITE_MODEL=anthropic/claude-sonnet-4-6
MCP_DOC_GENERATION_INVESTIGATION_MODEL=google/gemini-2.5-flash
# Cross-vendor safety net used only when the primary provider fails (rate limit,
# network, auth). Blank it if a run must never leave Anthropic.
MCP_DOC_GENERATION_FALLBACK_MODEL=openai/gpt-5.4
# Note: the customer Sources screen pins its own routing per request
# (custom harness + anthropic/claude-sonnet-4-6 for all three phases, see
# CUSTOMER_DOC_GENERATION_ROUTE in RAG_pipeline/frontend/lib/mcpClient.ts), so
# the MODEL values above apply to the internal dashboard and reingestion paths.
# Leave blank when using ANTHROPIC_API_KEY directly (standard endpoint).
# Only set these to override with a custom proxy or different provider.
MCP_DOC_GENERATION_API_KEY=
MCP_DOC_GENERATION_BASE_URL=
# DeepSeek alternative (uncomment to switch):
# MCP_DOC_GENERATION_PROVIDER=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_MODEL=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_WRITE_MODEL=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_DEEPSEEK_API_KEY=
# MCP_DOC_GENERATION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OpenRouter alternative (either key name works; OPENROUTER_API_KEY above is enough):
# MCP_DOC_GENERATION_OPENROUTER_API_KEY=
# MCP_DOC_GENERATION_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Deep dive provider (MCP server) ──────────────────────────────────────────
MCP_DEEP_DIVE_ENGINE=repo_agent
MCP_DEEP_DIVE_MODEL=anthropic/claude-sonnet-4-6
MCP_DEEP_DIVE_API_KEY=
MCP_DEEP_DIVE_BASE_URL=

# ── Hindsight (long-context memory LLM) ──────────────────────────────────────
# Model served by the local Ollama instance used by the Hindsight service.
HINDSIGHT_LLM_MODEL=gemma3:4b
MCP_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Network hardening ────────────────────────────────────────────────────────
# Optional IP allowlist (comma-separated addresses or CIDRs). Empty = disabled.
# Example: ALLOWED_IPS=203.0.113.4,198.51.100.0/24
ALLOWED_IPS=
# IPs of trusted reverse proxies. Set to the proxy's IP so FastAPI / slowapi see
# the real client IP via X-Forwarded-For.
#
# Two hops sit in front of the backend: nginx on the host, then the Next.js
# frontend container, which proxies every browser call to FastAPI. The backend's
# peer is therefore the frontend container on the Compose bridge network, and
# without that range here slowapi keys every rate limit (login, refresh, ...) on
# one address shared by all users -- a 429 on /auth/refresh then looks like a
# logout. Docker's default bridge pool is 172.16.0.0/12; narrow it to the actual
# subnet (`docker network inspect <project>_default`) if you prefer.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
