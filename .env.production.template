# intodata-kb production environment variables
# Copy to .env.production and update values as needed

# ── MCP Server ───────────────────────────────────────────────────────────────
MCP_DATABASE_URL=postgresql+asyncpg://admin:voetbal123@localhost:5432/intodata_kb
MCP_RAG_BASE_URL=http://localhost:8000
MCP_INTODOC_COMMAND=/opt/intodata-kb/venv/bin/intodoc
MCP_CLAUDE_COMMAND=claude
MCP_DATA_DIR=/opt/intodata-kb/knowledge_base/data
MCP_INTODOC_OUTPUT_DIR=/opt/intodata-kb/knowledge_base/intodoc-output
MCP_PROJECT_ROOT=/opt/intodata-kb/knowledge_base
MCP_HINDSIGHT_ENABLED=true
MCP_HINDSIGHT_URL=http://localhost:8888
MCP_LOG_LEVEL=INFO

# ── Dashboard static files ───────────────────────────────────────────────────
DASHBOARD_DIST_DIR=/opt/intodata-kb/knowledge_base/dashboard/dist

# ── Postgres (used by docker-compose) ────────────────────────────────────────
POSTGRES_DB=intodata_kb
POSTGRES_USER=admin
POSTGRES_PASSWORD=voetbal123
