# intodata-kb production environment variables
# Copy to .env and update values as needed
# Generate secrets with: openssl rand -hex 32

# ── Mission Control / Fleet (nexus operator server ONLY) ─────────────────────
# Set to true ONLY on the nexus.intodata.nl operator server.
# Customer VPS instances must leave this unset or false — Fleet must never
# be visible to customers.
FLEET_ENABLED=false

# ── Tenant identity (per deployment) ─────────────────────────────────────────
# One VPS per client — these env vars drive the branding shown in the sidebar,
# browser title, login page, and onboarding wizard chrome.
# TENANT_SLUG is the short identifier (usually matches the subdomain, e.g. "acme"
# for acme.intodata.nl). TENANT_ENVIRONMENT controls the small status pill —
# only "production" hides it; anything else (staging / development / preview) renders.
TENANT_NAME=IntoData
TENANT_SLUG=intodata
TENANT_ENVIRONMENT=production

# ── Live runtime (EP-004) ─────────────────────────────────────────────────────
# Provider-agnostic contract surfaced by GET /api/v1/runtime/status and used by
# the backend tool-use loop. Leave RUNTIME_PROVIDER_KEY empty to keep runtime
# disabled (chat indicator shows "disabled"). Provider keys:
#   mock       - credential-free in-memory fixtures (direct), for a quick check
#   stored     - DB-backed held runtime data read from Postgres (Model 2). Seed
#                local demo data with:
#                  cd RAG_pipeline/backend && python -m src.runtime.store.seed --project-id demo-runtime
#   talend_tmc - real Talend adapter (requires the Talend section below)
# RUNTIME_PROVIDER_HEALTH_URL is optional; without it status is "unavailable"
# even when a provider key is set.
# RUNTIME_PROVIDER_KEY=talend_tmc
# RUNTIME_PROVIDER_LABEL=Talend TMC
# RUNTIME_PROVIDER_HEALTH_URL=http://talend-tmc-runtime:9000/health
# RUNTIME_STATUS_TIMEOUT=5.0
# RUNTIME_TOOL_TIMEOUT=10.0
# RUNTIME_TOOL_RESULT_MAX_CHARS=12000

# ── Talend TMC runtime provider (EP-004 slice 5) ──────────────────────────────
# Only needed when RUNTIME_PROVIDER_KEY=talend_tmc. The API token is read from a
# mounted secret FILE, never an env var — do not put the token value in this
# file. See deploy/RUNBOOK.md ("Talend TMC runtime") for creating the secret
# file and bind-mounting it into the backend container.
# TALEND_TMC_BASE_URL=http://talend-tmc-runtime:9000
# TALEND_TMC_API_TOKEN_FILE=/run/secrets/talend_tmc_api_token

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret: openssl rand -hex 32
# IMPORTANT: JWT_SECRET_KEY and MCP_JWT_SECRET_KEY must be the SAME value
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
ADMIN_DEFAULT_PASSWORD=admin
# Set COOKIE_SECURE=true when using HTTPS (nginx/certbot reverse proxy)
COOKIE_SECURE=true
# Set to your DuckDNS or custom domain (e.g. myapp.duckdns.org)
COOKIE_DOMAIN=
# Single origin when behind nginx/certbot reverse proxy
ALLOWED_ORIGINS=https://YOUR_DOMAIN.duckdns.org
# Optional: keep enabled in production unless a trusted upstream handles CSRF.
CSRF_ENABLED=true

# ── Email invites (per deployment) ───────────────────────────────────────────
PUBLIC_APP_URL=https://YOUR_DOMAIN.duckdns.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Legacy alias accepted by docker-compose for older Ansible templates.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=YOUR_COMPANY_NAME
SMTP_USE_TLS=true

# ── Optional SSO / OIDC ──────────────────────────────────────────────────────
SSO_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ── MCP Server (runs in Docker Compose, host port 8002 by default) ───────────
# Password must match POSTGRES_PASSWORD below
MCP_DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@postgres:5432/intodata_kb
MCP_RAG_BASE_URL=http://backend:8000
MCP_INTODOC_COMMAND=intodoc
MCP_CLAUDE_COMMAND=claude
MCP_CLAUDE_MODEL=sonnet
MCP_DATA_DIR=/app/data
MCP_INTODOC_OUTPUT_DIR=/app/intodoc-output
MCP_PROJECT_ROOT=/app/workspace
MCP_HINDSIGHT_ENABLED=true
MCP_HINDSIGHT_URL=http://hindsight:8888
MCP_LOG_LEVEL=INFO
# Must match JWT_SECRET_KEY above
MCP_JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
MCP_ALLOWED_ORIGINS=https://YOUR_DOMAIN.duckdns.org
# API key for MCP->RAG doc ingestion (generate with: openssl rand -hex 32)
MCP_INGEST_API_KEY=CHANGE_ME_TO_A_RANDOM_KEY
# MCP network hardening — see ALLOWED_IPS / TRUSTED_PROXIES above for meaning
MCP_ALLOWED_IPS=
MCP_TRUSTED_PROXIES=127.0.0.1
MCP_APP_ENV=production
# Public app base URL used for generated GitHub webhook callback URLs.
MCP_PUBLIC_URL=https://YOUR_DOMAIN.duckdns.org
# GitHub webhook secret — generate with: openssl rand -hex 32
# Add the same value in GitHub repo Settings → Webhooks → Secret
MCP_GITHUB_WEBHOOK_SECRET=
# Must be false in production; true skips webhook signature checks.
MCP_DEV_WEBHOOK_SKIP_SIGNATURE=false
# Fernet key for encrypted GitHub PAT storage.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_TOKEN_ENCRYPTION_KEY=
# Host port published by the MCP REST API compose service
MCP_PORT=8002

# IntoData Ops telemetry. Disabled unless URL, API key, and client slug are set.
# Payloads contain operational metadata only: health, project status, run
# status, document counts, quality scores, token/cost totals, and redacted
# error summaries. Do not send uploaded docs, source code, generated doc bodies,
# chat history, raw logs, or secrets.
MCP_OPS_CLIENT_SLUG=
MCP_OPS_ENVIRONMENT=production
MCP_OPS_RELEASE_VERSION=
MCP_OPS_TELEMETRY_URL=
MCP_OPS_TELEMETRY_API_KEY=
MCP_OPS_TELEMETRY_INTERVAL_SECONDS=300

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=intodata_kb
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Email address seeded for the initial admin account on first boot.
# Set this per VPS/customer deployment from Ansible or the deploy UI. This is
# what the customer logs in with.
ADMIN_INITIAL_EMAIL=admin@YOUR_DOMAIN

# ── External APIs ────────────────────────────────────────────────────────────
# QDRANT_URL is intentionally omitted here. docker-compose defaults to
# http://qdrant:6333 (the internal service name), which is correct for all
# docker-compose deployments. Only set this if you are running the backend
# outside of docker-compose and need to point at a remote Qdrant instance.
# QDRANT_URL=http://qdrant:6333
# When set, docker-compose configures both the Qdrant service and clients with
# this API key. Leave blank only for isolated local/dev deployments.
QDRANT_API_KEY=
# Qdrant collection name. One VPS per client means each stack has its own Qdrant,
# so "documents" is fine as a default. Override only when running multiple stacks
# against a shared Qdrant instance (dev / staging on one host).
QDRANT_COLLECTION=documents
VOYAGE_API_KEY=
KIMI_API_KEY=
# Legacy generic fallback consumed by MCP_DOC_GENERATION_API_KEY when that
# variable is unset. Prefer provider-specific keys below.
LLM_API_KEY=

# ── LLM provider API keys ─────────────────────────────────────────────────────
# Set the key(s) for the providers you use. Unused keys can be left blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── Doc generation (MCP server) ───────────────────────────────────────────────
# Primary provider: anthropic (uses ANTHROPIC_API_KEY above).
# Models: phase 1-2 analysis, phase 3 writing, investigation sub-tasks, fallback.
MCP_DOC_GENERATION_PROVIDER=anthropic
MCP_DOC_GENERATION_MODEL=anthropic/claude-sonnet-4-6
MCP_DOC_GENERATION_WRITE_MODEL=anthropic/claude-sonnet-4-6
MCP_DOC_GENERATION_INVESTIGATION_MODEL=google/gemini-2.5-flash
MCP_DOC_GENERATION_FALLBACK_MODEL=openai/gpt-5.4
# Leave blank when using ANTHROPIC_API_KEY directly (standard endpoint).
# Only set these to override with a custom proxy or different provider.
MCP_DOC_GENERATION_API_KEY=
MCP_DOC_GENERATION_BASE_URL=
# DeepSeek alternative (uncomment to switch):
# MCP_DOC_GENERATION_PROVIDER=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_MODEL=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_WRITE_MODEL=openai/deepseek-v4-pro
# MCP_DOC_GENERATION_DEEPSEEK_API_KEY=
# MCP_DOC_GENERATION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Deep dive provider (MCP server) ──────────────────────────────────────────
MCP_DEEP_DIVE_ENGINE=repo_agent
MCP_DEEP_DIVE_MODEL=anthropic/claude-sonnet-4-6
MCP_DEEP_DIVE_API_KEY=
MCP_DEEP_DIVE_BASE_URL=

# ── Hindsight (long-context memory LLM) ──────────────────────────────────────
# Model served by the local Ollama instance used by the Hindsight service.
HINDSIGHT_LLM_MODEL=gemma3:4b
MCP_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Network hardening ────────────────────────────────────────────────────────
# Optional IP allowlist (comma-separated addresses or CIDRs). Empty = disabled.
# Example: ALLOWED_IPS=203.0.113.4,198.51.100.0/24
ALLOWED_IPS=
# IPs of trusted reverse proxies. Set to the proxy's IP so FastAPI / slowapi see
# the real client IP via X-Forwarded-For. Default 127.0.0.1 covers nginx
# on the same host; change when the proxy is on a different machine.
TRUSTED_PROXIES=127.0.0.1

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
