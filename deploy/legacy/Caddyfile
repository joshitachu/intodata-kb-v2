{$CADDY_DOMAIN:localhost} {
	# Global security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
		-Server
	}

	# RAG backend API
	handle /api/v1/* {
		reverse_proxy localhost:8000
	}

	# Health endpoint (RAG backend)
	handle /health {
		reverse_proxy localhost:8000
	}

	# Auth proxy for dashboard (rewrite /auth/* → /api/v1/auth/*)
	handle_path /auth/* {
		rewrite * /api/v1/auth{path}
		reverse_proxy localhost:8000
	}

	# Developer/control surfaces are not public on customer domains.
	handle /dashboard /dashboard/* {
		respond "Not found" 404
	}

	handle /mcp/* {
		respond "Not found" 404
	}

	handle /logs/* {
		respond "Not found" 404
	}

	# GitHub webhook remains public; the MCP handler verifies HMAC signatures.
	handle /webhook/* {
		reverse_proxy localhost:8002
	}

	# RAG frontend (default catch-all)
	handle {
		reverse_proxy localhost:3000
	}
}
