[Unit]
Description=intodoc MCP Server (Knowledge Base API + Dashboard)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/root/intodoc/intodata-kb-v2/knowledge_base
EnvironmentFile=/root/intodoc/intodata-kb-v2/.env
ExecStart=/opt/intodata-kb/venv/bin/python -m mcp_server \
    --serve \
    --port 8002
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
