[Unit]
Description=intodoc MCP Server (Knowledge Base API + Dashboard)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/intodoc/intodata-kb-v2/knowledge_base
ExecStart=/opt/intodata-kb/venv/bin/python -m mcp_server \
    --serve \
    --static-dir /root/intodoc/intodata-kb-v2/knowledge_base/dashboard/dist
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
