[Unit]
Description=intodoc MCP Server (Knowledge Base API + Dashboard)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=intodata
Group=intodata
WorkingDirectory=/home/intodata/intodata-kb-v2/knowledge_base
EnvironmentFile=/home/intodata/intodata-kb-v2/.env
ExecStart=/home/intodata/intodata-kb-v2/venv/bin/python -m mcp_server \
    --serve \
    --port 8002
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
