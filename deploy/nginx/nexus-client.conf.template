# nginx server block for per-client Nexus stacks.
#
# Rendered by deploy/deploy-client.sh via `envsubst`. Required variables
# (written here WITHOUT the dollar-brace form on purpose: envsubst also expands
# comments, and a multi-line value such as OPS_CONTROL_ALLOW would spill out of
# the comment and break `nginx -t`):
#   CLIENT               -- subdomain slug (e.g. "acme" -> acme.nexus.intodata.nl)
#   NEXUS_BASE           -- base domain (e.g. "nexus.intodata.nl")
#   BACKEND_PORT         -- host port for the RAG backend container
#   FRONTEND_PORT        -- host port for the Next.js frontend container
#   MCP_PORT             -- host port for the MCP server container
#   OPS_CONTROL_ALLOW    -- `allow <ip>;` lines plus `deny all;` for
#                           /ops/control/, built from OPS_CONTROL_ALLOWED_IPS
#                           in the client env file; empty = no IP restriction
#   FLEET_TELEMETRY_INGRESS -- the heartbeat route to the central Mission
#                           Control (deploy/operator/nginx-fleet-telemetry.conf,
#                           port rewritten), rendered ONLY with --fleet-host on
#                           the operator host; empty on every client stack
#
# SSL is provisioned by certbot --nginx after this file is in place, so the
# template itself is HTTP-only until certbot adds the 443 block.

server {
    listen 80;
    server_name ${CLIENT}.${NEXUS_BASE};

    # Real client IP propagation — FastAPI / slowapi rely on these headers
    # (see trusted_proxies in config). Without them rate limits would key on
    # the nginx IP and be effectively global.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Security headers — certbot --nginx copies this server block to the 443
    # block, so these will be present on HTTPS responses after SSL is issued.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP covers both front-ends on this host: the Next.js app needs inline
    # scripts for hydration and inline styles (mermaid); the /dashboard/ SPA
    # loads Google Fonts. Everything else, including SSE, is same-origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;

    # RAG backend — all /api/v1/* endpoints
    location /api/v1/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT}$request_uri;
    }

    # Health endpoint (same backend)
    location = /health {
        proxy_pass http://127.0.0.1:${BACKEND_PORT}/health;
    }

    # GitHub webhook — HMAC-verified, no JWT required.
    location /webhook/ {
        proxy_pass http://127.0.0.1:${MCP_PORT}$request_uri;
    }

    # Fleet heartbeat ingress: empty unless deploy-client.sh ran with --fleet-host.
${FLEET_TELEMETRY_INGRESS}
    # Mission Control -> instance control channel (scan, generate, licence push).
    # A machine caller: the MCP route checks a bearer key (MCP_OPS_CONTROL_KEY,
    # constant-time) and answers 503 while it is unset, so there is deliberately
    # NO superadmin auth_request here -- the caller has no user cookie. Without
    # this block the path fell through to the Next.js catch-all and never
    # reached mcp-server. The optional allowlist narrows it to the central
    # Mission Control host(s).
    #
    # proxy_pass forwards the raw $request_uri, so only the exact control
    # routes may pass; anything else (dot segments, encoded slashes, query
    # strings, unknown paths) is 400 before it can be interpreted differently
    # by nginx and by the app. The project id charset and length mirror
    # PROJECT_ID_PATTERN in mcp_server/schemas.py. `return` is safe inside `if`.
    # (The rewrite phase runs before allow/deny, so a malformed path is 400
    # even from a non-allowlisted IP; a well-formed one still gets 403.)
    location /ops/control/ {
        if ($request_uri !~ "^/ops/control/(licence|scan/[A-Za-z0-9][A-Za-z0-9_-]{0,99}|generate/[A-Za-z0-9][A-Za-z0-9_-]{0,99})$") {
            return 400;
        }
        ${OPS_CONTROL_ALLOW}
        proxy_pass http://127.0.0.1:${MCP_PORT}$request_uri;
        client_max_body_size 64k;
    }

    # Operator surface, published on the customer domain but gated on superadmin.
    #
    # The gate is an nginx auth_request subrequest to the MCP server, which
    # checks users.is_superadmin for the caller's JWT cookie. It is enforced at
    # the edge deliberately: the MCP routers themselves must stay on plain
    # require_auth, because the customer app proxies /mcp/scan, /mcp/generate,
    # /mcp/push-to-rag and friends through /api/source/* on behalf of ordinary
    # users. Gating those routers would break onboarding.
    #
    # Regular users get 403 here; the customer app is unaffected because it
    # reaches MCP server-side over the compose network, never through this edge.
    location = /internal/authz/superadmin {
        internal;
        proxy_pass http://127.0.0.1:${MCP_PORT}/internal/authz/superadmin;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        # Fail fast. nginx defaults to a 60s read timeout, so while mcp-server is
        # saturated by a doc-generation run every gated request used to hang for a
        # minute before 504-ing, which made the whole operator surface look dead.
        # A 3s ceiling keeps the gate cheap: it is one indexed lookup on users.
        proxy_connect_timeout 2s;
        proxy_send_timeout 2s;
        proxy_read_timeout 3s;
        proxy_next_upstream off;
    }

    location /mcp/ {
        auth_request /internal/authz/superadmin;
        proxy_pass http://127.0.0.1:${MCP_PORT}$request_uri;
    }

    location /logs/ {
        auth_request /internal/authz/superadmin;
        proxy_pass http://127.0.0.1:${MCP_PORT}$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location /dashboard/ {
        auth_request /internal/authz/superadmin;
        proxy_pass http://127.0.0.1:${DASHBOARD_PORT}$request_uri;
    }

    # The dashboard SPA calls /auth/me and /auth/logout, and the Nexus harness
    # routes under /nexus-api/. Both are backend paths under a different prefix;
    # mirror the rewrites the dashboard container's own nginx does, behind the
    # same superadmin gate. Neither prefix collides with a Next.js route.
    location /auth/ {
        auth_request /internal/authz/superadmin;
        rewrite ^/auth/(.*)$ /api/v1/auth/$1 break;
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
    }

    location /nexus-api/ {
        auth_request /internal/authz/superadmin;
        rewrite ^/nexus-api/(.*)$ /api/v1/$1 break;
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
    }

    # The dashboard SPA loads its bundles from /assets/*. Same gate.
    location /assets/ {
        auth_request /internal/authz/superadmin;
        proxy_pass http://127.0.0.1:${DASHBOARD_PORT}$request_uri;
    }

    # Next.js frontend — default catch-all
    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
